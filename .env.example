# Public URL of the app, used for OAuth and Stripe redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Auth only; data lives in Postgres via DATABASE_URL)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Postgres connection string (Supabase "Transaction pooler" URL works)
DATABASE_URL=postgres://postgres:password@localhost:5432/postgres

# Salesforce Connected App (OAuth web-server flow with PKCE).
# Callback URL to register: ${NEXT_PUBLIC_APP_URL}/api/salesforce/callback
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# 32 random bytes, base64. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Billing. Leave BILLING_ENABLED=false to keep the full report free (current behaviour).
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONITOR=
STRIPE_PRICE_AUDIT=
STRIPE_PRICE_CONSULT=
# How long a one-off audit unlocks the full report, in hours.
AUDIT_ACCESS_HOURS=48
CALENDLY_URL=https://calendly.com/salesforcesaver-support/30min

# Claude, for the connected-app tool analysis and contract price extraction.
ANTHROPIC_API_KEY=

# Shared secret the scheduler sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
